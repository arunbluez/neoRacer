{
  // Portable core: plain ES only. No DOM lib, no Node types, so any browser
  // or platform API used here is a compile error. Only the tiny timer
  // declarations in src/core/runtime.d.ts are allowed.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src/core/**/*.ts"],
  "exclude": ["src/core/**/*.test.ts", "src/core/testing/**"]
}
